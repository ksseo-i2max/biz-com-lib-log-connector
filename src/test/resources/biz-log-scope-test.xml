<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:biz-log="http://www.mulesoft.org/schema/mule/biz-log"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/biz-log
        http://www.mulesoft.org/schema/mule/biz-log/current/mule-biz-log.xsd">

  <!--
    Scope 에는 config-ref 가 없다. Mule SDK 가 Scope 의 config 바인딩을 금지하므로
    flowVersion / baseTableName 을 Scope 파라미터로 직접 받는다.
  -->

  <!-- (1) 로그 대상 2개 + 컨텍스트 4개가 모두 attributes 로 노출되는지 -->
  <flow name="scopeExposesAttributes">
    <biz-log:logging-context flowVersion="v1"
                          baseTableName="MULE_BIZ_INTERFACE_LOG"
                          triggerType="API"
                          actor="SFDC"
                          targetAppName="SFDC"
                          status="SUCCESS" includeRequestPayload="false" includeResponsePayload="false">
      <set-payload value="#[
        attributes.flowVersion ++ '|' ++
        attributes.baseTableName ++ '|' ++
        attributes.triggerType ++ '|' ++
        attributes.actor ++ '|' ++
        attributes.targetAppName ++ '|' ++
        attributes.status
      ]"/>
    </biz-log:logging-context>
  </flow>

  <!-- (2) 원본 payload 가 보존되는지 (pass-through) -->
  <flow name="scopePreservesPayload">
    <biz-log:logging-context flowVersion="v1"
                          baseTableName="MULE_BIZ_INTERFACE_LOG"
                          triggerType="API"
                          actor="SFDC"
                          targetAppName="LOCAL"
                          status="FAIL" includeRequestPayload="false" includeResponsePayload="false">
      <logger level="DEBUG" message="#[attributes.actor]"/>
    </biz-log:logging-context>
  </flow>

  <!--
    (3) 스코프 내부 예외가 원본 에러 타입으로 전파되는지.
        내부에서 EXPRESSION 에러를 유발하고, 플로우 레벨 error-handler 가
        잡은 에러 타입 문자열을 payload 로 돌려준다.
        BIZ-LOG:* 로 감싸이면 이 단정이 깨진다.
  -->
  <flow name="scopePropagatesInnerErrorType">
    <biz-log:logging-context flowVersion="v1"
                          baseTableName="MULE_BIZ_INTERFACE_LOG"
                          triggerType="API"
                          actor="SFDC"
                          targetAppName="SFDC"
                          status="FAIL" includeRequestPayload="false" includeResponsePayload="false">
      <set-payload value="#[1 / 0 as String {format: 'x'}]"/>
    </biz-log:logging-context>
    <error-handler>
      <on-error-continue type="ANY">
        <set-payload value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
      </on-error-continue>
    </error-handler>
  </flow>

  <!-- (4) 진입 전 payload / attributes 가 originPayload / originAttributes 로 실리는지 -->
  <flow name="scopeExposesOriginMessage">
    <biz-log:logging-context baseTableName="MULE_BIZ_INTERFACE_LOG"
                          triggerType="API"
                          actor="SFDC"
                          targetAppName="SFDC"
                          status="SUCCESS" includeRequestPayload="false" includeResponsePayload="false">
      <set-payload value="#[attributes.originPayload]"/>
    </biz-log:logging-context>
  </flow>

  <!--
    (5) 체인이 payload 를 교체한 뒤에도 originPayload 로 원본을 되찾을 수 있는지.
        스코프 attributes 는 교체되므로 먼저 vars 로 옮겨 둔다.
  -->
  <flow name="scopeOriginPayloadSurvivesReplacement">
    <biz-log:logging-context baseTableName="MULE_BIZ_INTERFACE_LOG"
                          triggerType="API"
                          actor="SFDC"
                          targetAppName="SFDC"
                          status="SUCCESS" includeRequestPayload="false" includeResponsePayload="false">
      <set-variable variableName="ctx" value="#[attributes]"/>
      <set-payload value="#[{ replaced: true }]"/>
      <set-payload value="#[vars.ctx.originPayload]"/>
    </biz-log:logging-context>
  </flow>

  <!--
    (6) correlationId 가 새로 만들어지지 않고 현재 이벤트의 값과 동일한지.
        스코프 진입 전 correlationId 를 vars 에 담아두고 컨텍스트의 값과 비교한다.
  -->
  <flow name="scopeReusesEventCorrelationId">
    <set-variable variableName="expectedCorrelationId" value="#[correlationId]"/>
    <biz-log:logging-context baseTableName="MULE_BIZ_INTERFACE_LOG"
                          triggerType="API"
                          actor="SFDC"
                          targetAppName="SFDC"
                          status="SUCCESS" includeRequestPayload="false" includeResponsePayload="false">
      <set-payload value="#[
        if (attributes.correlationId == vars.expectedCorrelationId) 'SAME' else 'DIFFERENT'
      ]"/>
    </biz-log:logging-context>
  </flow>

  <!-- (7) startTime 이 채워지는지 -->
  <flow name="scopeStampsStartTime">
    <biz-log:logging-context baseTableName="MULE_BIZ_INTERFACE_LOG"
                          triggerType="BATCH"
                          actor="SFDC"
                          targetAppName="SFDC"
                          status="SUCCESS" includeRequestPayload="false" includeResponsePayload="false">
      <set-payload value="#[if (attributes.startTime != null) 'T' else 'F']"/>
    </biz-log:logging-context>
  </flow>

  <!--
    (8) sourceAppName 이 Java 에서 app.name 프로퍼티로 채워지는지.
        DSL 파라미터가 아니므로 사용자가 지정할 수 없다. 앱 이름은 환경마다 다르므로
        값을 직접 단정하지 않고 p('app.name') 과 비교한다.
  -->
  <flow name="scopeDerivesSourceAppNameFromProperty">
    <biz-log:logging-context includeRequestPayload="false" includeResponsePayload="false">
      <set-payload value="#[
        if (attributes.sourceAppName == p('app.name')) 'SAME' else 'DIFFERENT'
      ]"/>
    </biz-log:logging-context>
  </flow>

  <!--
    (9) includeRequestPayload 게이팅. 두 플래그는 필수 속성이므로 항상 명시한다.
        켜면 진입 직전 payload 가 requestPayload 로, 끄면 null 이 되어야 한다.
        originPayload 는 플래그와 무관하게 항상 담긴다.
  -->
  <flow name="scopeIncludesRequestPayloadWhenEnabled">
    <biz-log:logging-context includeRequestPayload="true" includeResponsePayload="false">
      <set-payload value="#[attributes.requestPayload]"/>
    </biz-log:logging-context>
  </flow>

  <flow name="scopeOmitsRequestPayloadWhenDisabled">
    <biz-log:logging-context includeRequestPayload="false" includeResponsePayload="false">
      <set-payload value="#[
        (if (attributes.requestPayload == null) 'NULL' else 'SET') ++ '|' ++
        attributes.originPayload
      ]"/>
    </biz-log:logging-context>
  </flow>

  <!--
    (10) 기본값이 있는 파라미터를 모두 생략했을 때 적용되는 값.
         필수인 include 플래그 2개만 명시한다.
         v1 / MULE_BIZ_INTERFACE_LOG / API / SFDC / biz-com-exp-listener / SUCCESS
         (sourceAppName 은 환경 의존이라 위 (8) 에서 따로 검증한다)
  -->
  <flow name="scopeAppliesDefaults">
    <biz-log:logging-context includeRequestPayload="false" includeResponsePayload="false">
      <set-payload value="#[
        attributes.flowVersion ++ '|' ++
        attributes.baseTableName ++ '|' ++
        attributes.triggerType ++ '|' ++
        attributes.actor ++ '|' ++
        attributes.targetAppName ++ '|' ++
        attributes.status
      ]"/>
    </biz-log:logging-context>
  </flow>

  <!-- (11) 공백 파라미터 -> BIZ-LOG:INVALID_CONTEXT -->
  <flow name="scopeRejectsBlankParameter">
    <biz-log:logging-context flowVersion=" "
                          baseTableName="MULE_BIZ_INTERFACE_LOG"
                          triggerType="API"
                          actor="SFDC"
                          targetAppName="SFDC"
                          status="SUCCESS" includeRequestPayload="false" includeResponsePayload="false">
      <logger level="DEBUG" message="여기까지 오면 안 된다"/>
    </biz-log:logging-context>
    <error-handler>
      <on-error-continue type="ANY">
        <set-payload value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
      </on-error-continue>
    </error-handler>
  </flow>

</mule>
