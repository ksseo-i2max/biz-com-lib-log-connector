<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:biz-log="http://www.mulesoft.org/schema/mule/biz-log"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/biz-log
        http://www.mulesoft.org/schema/mule/biz-log/current/mule-biz-log.xsd">

  <biz-log:config name="BizLog_Config"
                  flowVersion="v2"
                  baseTableName="TB_IF_LOG_HIST"/>

  <!-- (1) target 으로 지정한 variable 에 컨텍스트가 실리는지 -->
  <flow name="operationStoresContextInVariable">
    <biz-log:build-context config-ref="BizLog_Config"
                           triggerType="BATCH"
                           actor="scheduler"
                           targetAppName="SAP"
                           status="FAIL"
                           target="ctx" includeRequestPayload="false" includeResponsePayload="false"/>
    <set-payload value="#[
      vars.ctx.flowVersion ++ '|' ++
      vars.ctx.baseTableName ++ '|' ++
      vars.ctx.triggerType ++ '|' ++
      vars.ctx.actor ++ '|' ++
      vars.ctx.targetAppName ++ '|' ++
      vars.ctx.status
    ]"/>
  </flow>

  <!--
    (2) 메시지(payload + attributes) 가 완전히 교체된 뒤에도 vars.ctx 가 살아남는지.
        Scope 의 attributes 방식과 대비되는 핵심 차이점이다.
  -->
  <flow name="variableSurvivesMessageReplacement">
    <biz-log:build-context config-ref="BizLog_Config"
                           triggerType="API"
                           actor="integration-user"
                           targetAppName="LEGACY"
                           status="SUCCESS"
                           target="ctx" includeRequestPayload="false" includeResponsePayload="false"/>

    <!-- 메시지 전체 교체를 모사 -->
    <set-payload value="#[{ replaced: true }]"/>
    <remove-variable variableName="doesNotExist"/>

    <set-payload value="#[vars.ctx.actor ++ '|' ++ vars.ctx.status]"/>
  </flow>

  <!--
    (3) 진입 전 payload / attributes 가 originPayload / originAttributes 로 실리는지.
        Operation 은 vars 에 저장되므로 이후 메시지 교체와 무관하게 원본이 남는다.
  -->
  <flow name="operationExposesOriginMessage">
    <biz-log:build-context config-ref="BizLog_Config"
                           triggerType="API"
                           actor="SFDC"
                           targetAppName="SFDC"
                           status="SUCCESS"
                           target="ctx" includeRequestPayload="false" includeResponsePayload="false"/>
    <set-payload value="#[{ replaced: true }]"/>
    <set-payload value="#[vars.ctx.originPayload]"/>
  </flow>

  <!-- (4) correlationId 가 새로 만들어지지 않고 현재 이벤트의 값과 동일한지 -->
  <flow name="operationReusesEventCorrelationId">
    <biz-log:build-context config-ref="BizLog_Config"
                           triggerType="API"
                           actor="SFDC"
                           targetAppName="SFDC"
                           status="SUCCESS"
                           target="ctx" includeRequestPayload="false" includeResponsePayload="false"/>
    <set-payload value="#[
      if (vars.ctx.correlationId == correlationId) 'SAME' else 'DIFFERENT'
    ]"/>
  </flow>

  <!-- (5) startTime 이 채워지는지 -->
  <flow name="operationStampsStartTime">
    <biz-log:build-context config-ref="BizLog_Config"
                           triggerType="BATCH"
                           actor="scheduler"
                           targetAppName="SAP"
                           status="SUCCESS"
                           target="ctx" includeRequestPayload="false" includeResponsePayload="false"/>
    <set-payload value="#[if (vars.ctx.startTime != null) 'T' else 'F']"/>
  </flow>

  <!--
    (6) sourceAppName 이 p('app.name') 으로 채워지는지.
        앱 이름은 환경마다 다르므로 값을 직접 단정하지 않고 p('app.name') 과 비교한다.
  -->
  <flow name="operationDerivesSourceAppNameFromProperty">
    <biz-log:build-context config-ref="BizLog_Config" target="ctx" includeRequestPayload="false" includeResponsePayload="false"/>
    <set-payload value="#[
      if (vars.ctx.sourceAppName == p('app.name')) 'SAME' else 'DIFFERENT'
    ]"/>
  </flow>

  <!--
    (7) 모든 파라미터에 기본값이 있으므로 config 는 이름만, operation 은
        config-ref / target 만으로 동작해야 한다.
        v1 / MULE_BIZ_INTERFACE_LOG / API / SFDC / biz-com-exp-listener / SUCCESS
        (sourceAppName 은 환경 의존이라 위 (6) 에서 따로 검증한다)
  -->
  <biz-log:config name="BizLog_Config_Default"/>

  <flow name="operationAppliesDefaults">
    <biz-log:build-context config-ref="BizLog_Config_Default" target="ctx" includeRequestPayload="false" includeResponsePayload="false"/>
    <set-payload value="#[
      vars.ctx.flowVersion ++ '|' ++
      vars.ctx.baseTableName ++ '|' ++
      vars.ctx.triggerType ++ '|' ++
      vars.ctx.actor ++ '|' ++
      vars.ctx.targetAppName ++ '|' ++
      vars.ctx.status
    ]"/>
  </flow>

  <!-- (8) target 없이 쓰면 payload 로 나오는지 -->
  <flow name="operationWithoutTargetReturnsPayload">
    <biz-log:build-context config-ref="BizLog_Config"
                           triggerType="API"
                           actor="ops"
                           targetAppName="ADMIN"
                           status="SUCCESS" includeRequestPayload="false" includeResponsePayload="false"/>
    <set-payload value="#[payload.actor ++ '|' ++ payload.targetAppName]"/>
  </flow>

</mule>
